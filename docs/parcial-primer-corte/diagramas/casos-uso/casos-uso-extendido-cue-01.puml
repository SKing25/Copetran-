@startuml casos_uso_extendido_cue01
skinparam packageStyle rectangle
left to right direction
skinparam linetype ortho
skinparam nodesep 70
skinparam ranksep 70
title Diagrama de Caso de Uso Extendido — CUE-01: Comprar Tiquete de Pasajero (Proceso A)

actor "Cliente" as Cliente
actor "Cajero de\nAgencia" as Cajero
actor "Sistema de\nPagos" as Pagos
actor "Auxiliar de\nDespacho" as Auxiliar
actor "Facturación Electrónica\nDIAN" as DIAN

rectangle "CUE-01 — Comprar Tiquete de Pasajero" {
  usecase "Reservar Tiquete Sin\nPago Inmediato" as Ext1
  usecase "Habilitar Tiquete\nAbierto" as Ext2
  usecase "Reprogramar Tiquete\nAbierto" as Ext3
  usecase "Cancelar Tiquete" as Ext4

  usecase "Comprar Tiquete\nde Pasajero" as Base

  usecase "Consultar Disponibilidad\nde Viaje" as Inc0
  usecase "Consultar Disponibilidad\nde Silla" as Inc1
  usecase "Registrar Cliente" as Inc2
  usecase "Bloquear Silla\nTemporalmente" as Inc3
  usecase "Generar Factura" as Inc4
  usecase "Confirmar Pago" as Inc5
}

