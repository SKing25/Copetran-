@startuml secuencia_admision_mensajeria
title Diagrama de Secuencia — Proceso C: Admisión y Consolidación de Mensajería
actor "Cliente\n(Remitente)" as Remitente
actor "Operario de Bodega" as Operario
participant "InterfazAdmisionGuia" as UI
participant "ControladorAdmision" as Controlador
participant "ClienteDAO" as ClienteDAO
participant "GuiaEnvioDAO" as GuiaDAO
participant "BodegaHubDAO" as BodegaDAO
participant "RemesaDAO" as RemesaDAO
participant "FacturaDAO" as FacturaDAO

Remitente -> Operario : entregarPaquete(datosRemitente, datosDestinatario, peso, dimensiones)
Operario -> UI : digitarAdmision(datos, pesaje, dimensiones)
UI -> Controlador : iniciarAdmision(remitente, destinatario, peso, dimensiones)
activate Controlador

opt uno de los clientes no está registrado
    Controlador -> ClienteDAO : verificarRegistrados(documentos)
    activate ClienteDAO
    ClienteDAO --> Controlador : faltaAlguno
    deactivate ClienteDAO
    Controlador -> ClienteDAO : insertar(clienteFaltante)
end

Controlador -> GuiaDAO : calcularTarifa(peso, categoria)
activate GuiaDAO
GuiaDAO --> Controlador : tarifaCalculada
deactivate GuiaDAO

Controlador -> BodegaDAO : validarCapacidad(idBodega, pesoKg)
activate BodegaDAO
BodegaDAO --> Controlador : capacidadOk
deactivate BodegaDAO

Controlador -> GuiaDAO : generarGuia(codigoBarras, "ADMITIDO")
activate GuiaDAO
GuiaDAO --> Controlador : guiaGenerada(idGuia)
deactivate GuiaDAO

opt paga en el momento
    Controlador -> FacturaDAO : asociarFactura(idGuia)
    activate FacturaDAO
    FacturaDAO --> Controlador : facturaAsociada
    deactivate FacturaDAO
end

Controlador -> RemesaDAO : buscarRemesaCompatible(remitente, destino)
activate RemesaDAO
RemesaDAO --> Controlador : remesaEncontrada / ninguna
alt remesa compatible encontrada
    Controlador -> GuiaDAO : consolidarEnRemesa(idGuia, idRemesa)
    Controlador -> RemesaDAO : recalcularTotales(idRemesa)
    RemesaDAO --> Controlador : totalesActualizados
else sin remesa
    Controlador -> GuiaDAO : guardarGuiaIndependiente()
end
deactivate RemesaDAO

Controlador --> UI : confirmarAdmision(numeroGuia)
UI --> Operario : mostrarConfirmacion(numeroGuia)
deactivate Controlador
@enduml